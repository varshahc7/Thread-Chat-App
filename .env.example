# Copy to .env. Every value has a working default for local development.
ENVIRONMENT=development
# SQLite is the default for local dev; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./private_chat.db
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MAX_MESSAGE_LENGTH=5000
MAX_FILE_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TCP_ENABLED=true
TCP_PORT=9000
UPLOAD_DIR=./uploads
# Comma-separated usernames allowed to open the debug panel
ADMIN_USERNAMES=
DEBUG_PANEL_ENABLED=true
RATE_LIMIT_ENABLED=true
# docker-compose only
POSTGRES_USER=thread
POSTGRES_PASSWORD=thread
POSTGRES_DB=thread
